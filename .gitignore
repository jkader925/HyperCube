# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# OS cruft
.DS_Store

# Data cubes, fit outputs, and sessions (too large / user-specific for the repo)
*.fits
*.hcsession
*.csv

# Bundled stellar template libraries — these SHIP WITH the tool (8.5 MB total).
# They live under the *.fits rule above, so they need explicit negations; without
# these a fresh clone has no stellar templates and pPXF fitting is unavailable.
!eMILES/**
!indo_us_library/**

# Keep small example/config CSVs explicitly if needed by un-ignoring, e.g.:
# !example_config.csv
